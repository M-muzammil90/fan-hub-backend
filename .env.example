# ─────────────────────────────────────────────────────────────────────────────
#  Fan Hub Plus Backend — Environment Variables
#  Copy this file to .env and fill in your values before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# MongoDB (use MongoDB Atlas connection string for production)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Email (for password reset, etc.)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Frontend URL (CORS) — set to your deployed frontend Vercel URL
# Example: https://fan-hub-plus.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Cloudinary (for image / media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
